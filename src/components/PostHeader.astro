---
// library import
import { Image } from "@astrojs/image/components";

// utils imports
import { formatDate, slugify } from "../js/utils";

const { title, description, date, category, author, image } = Astro.props;
---

<header>
  <div class="container">
    <small><a href={`../category/${slugify(category)}`}>{category}</a></small>
    <h1 class="h2">{title}</h1>
    <p>{formatDate(date)}</p>
  </div>
  <Image
    src={image.src}
    alt={image.alt}
    width="1200"
    height="600"
    format="avif"
    fit="cover"
    quality={80}
    aspectRatio="5:2"
    class="hero-image"
  />
</header>
